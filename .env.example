# Copy to .env and fill in. Never commit .env.

# LLM via Ollama Cloud (https://ollama.com/settings/keys). Free-plan models include
# gpt-oss:120b, gpt-oss:20b, gemma4:31b, nemotron-3-nano:30b.
OLLAMA_API_KEY=
LLM_MODEL=gpt-oss:120b
FAST_LLM_MODEL=gpt-oss:20b
# For a local Ollama server instead of the cloud, remove the key and set:
# OLLAMA_HOST=http://127.0.0.1:11434

# Local embeddings (private). Alternatives: BAAI/bge-base-en-v1.5 (better, slower).
EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_ENABLED=true

# ── Supabase (primary storage) ── leave all three empty to run fully offline on the local SQLite file.
# Server-side only: none of these values is ever sent to the browser.
# Session-pooler connection string for the least-privilege role nyaya_app (see docs/SUPABASE_MIGRATION.md):
# SUPABASE_DB_URL=postgresql://nyaya_app.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
# Project URL and the SECRET key (Settings > API Keys: sb_secret_... ; a legacy service_role key also works).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=case-files
# DB_POOL_MAX=8

# OCR for scanned PDFs and images: built in (RapidOCR). Its models (~40 MB, English + Hindi/Marathi) download once
# on first use (python -m nyaya.ocr download fetches them now). Tesseract is used instead when installed.
# OCR_ENGINE=auto            # auto | rapidocr | tesseract | off
# OCR_DOWNLOAD=true          # allow the one-time Hindi/Marathi model download during processing
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_MAX_PAGES=60
# Upper limit on text sent to the LLM for whole-document translation / summaries (characters).
# DOC_LLM_MAX_CHARS=120000

# Background synchronisation (LiveLaw RSS hourly, India Code act records daily). false = manual "Sync now" only.
# SYNC_ENABLED=true
# SYNC_TICK_SECONDS=60

# PDF export font (defaults to Windows' Nirmala UI, which covers Latin + Devanagari).
# EXPORT_FONT=/usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf
# EXPORT_FONT_BOLD=/usr/share/fonts/truetype/noto/NotoSansDevanagari-Bold.ttf

# ── Accounts (Supabase Auth, used by the backend only; see docs/SECURITY.md) ──
# Publishable key (Settings > API Keys: sb_publishable_...). With SUPABASE_URL + this key the app uses per-user
# accounts; without them it runs in local single-user mode (loopback only).
SUPABASE_PUBLISHABLE_KEY=
# AUTH_MODE=auto              # auto | supabase | local
# SIGNUP_MODE=open            # open (anyone registers as a Lawyer) | invite_only (an administrator invites each e-mail)
# MFA_REQUIRED_ROLES=admin,advocate
# SESSION_TTL_HOURS=12
# SESSION_IDLE_MINUTES=60
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# Shared server key for CSRF values and recovery-code hashes; required when more than one app instance runs.
# APP_SECRET_KEY=
# Public HTTPS address when deployed behind a TLS proxy (Secure cookies, HSTS, e-mail link target).
# PUBLIC_URL=https://nyaysutra.example.org

# AI data protection: mask Aadhaar / PAN / phone / e-mail / bank account / card / passport numbers before text is
# sent to the LLM (restored in the reply). Names and facts are still sent.
# AI_PII_REDACTION=true
# Optional ClamAV scan of uploads: path to clamscan/clamdscan; empty = auto-detect on PATH; off = disabled.
# CLAMAV_CMD=

# ── Background jobs, bulk upload, LLM resilience (see docs/RELIABILITY.md) ──
# INGEST_WORKERS=1            # parallel document processing (CPU-bound)
# JOB_WORKERS=2               # parallel translations / summaries / drafts
# INGEST_MAX_ATTEMPTS=3
# JOB_TIMEOUT_SECONDS=900
# BATCH_MAX_FILES=50
# BATCH_MAX_TOTAL_MB=500
# LLM_RETRIES=2
# LLM_FALLBACK_MODEL=gpt-oss:20b   # empty = no fallback
# LLM_BREAKER_FAILURES=4
# LLM_BREAKER_SECONDS=60

# Server. Keep 127.0.0.1 in local single-user mode unless APP_PASSWORD is set.
APP_HOST=127.0.0.1
APP_PORT=8000
# APP_PASSWORD=               # local single-user mode only
# MAX_UPLOAD_MB=40

# ── Calendar reminders (optional e-mail through your own SMTP server; in-app reminders always work) ──
# DEFAULT_TIMEZONE=Asia/Kolkata
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=NyaySutra <noreply@example.com>
# SMTP_STARTTLS=true
